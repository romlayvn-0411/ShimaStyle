<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>items</key>
    <array>
        <!-- Header -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>ShimaStyle</string>
            <key>footerText</key>
            <string>Bắt buộc tất cả thông báo ứng dụng hiển thị qua Dynamic Island.</string>
        </dict>

        <!-- Enable Toggle -->
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>enabled</string>
            <key>label</key>
            <string>Bật Tweak</string>
        </dict>

        <!-- Notification Section -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Thông báo</string>
            <key>footerText</key>
            <string>Khi được bật, các thông báo sẽ được hiển thị qua Dynamic Island và biểu ngữ thông báo mặc định sẽ bị ẩn.</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>notificationEnabled</string>
            <key>label</key>
            <string>Thông báo Dynamic Island</string>
            <key>PostNotification</key>
            <string>com.34306.shimastyle/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSegmentCell</string>
            <key>default</key>
            <integer>0</integer>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>notificationStyle</string>
            <key>validValues</key>
            <array>
                <integer>0</integer>
                <integer>1</integer>
                <integer>2</integer>
            </array>
            <key>validTitles</key>
            <array>
                <string>Tiêu chuẩn</string>
                <string>Nhỏ gọn</string>
                <string>Tối giản</string>
            </array>
            <key>PostNotification</key>
            <string>com.34306.shimastyle/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>5.0</real>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>dismissDuration</string>
            <key>label</key>
            <string>Đóng sau (giây)</string>
            <key>min</key>
            <real>1.0</real>
            <key>max</key>
            <real>15.0</real>
            <key>showValue</key>
            <true/>
            <key>PostNotification</key>
            <string>com.34306.shimastyle/prefsChanged</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Hiển thị thông báo thử nghiệm</string>
            <key>action</key>
            <string>testNotification</string>
        </dict>

        <!-- Custom Background Section -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Hình nền tùy chỉnh</string>
            <key>footerText</key>
            <string>Tùy chỉnh hình nền Dynamic Island. Sử dụng mã màu hex (ví dụ: #FF5733) hoặc cung cấp đường dẫn đầy đủ đến hình ảnh nền trên thiết bị.</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>default</key>
            <false/>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>customBackgroundEnabled</string>
            <key>label</key>
            <string>Bật hình nền tùy chỉnh</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>default</key>
            <string>#1C1C1E</string>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>customBackgroundColorHex</string>
            <key>label</key>
            <string>Màu nền (Hex)</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>customBackgroundImagePath</string>
            <key>label</key>
            <string>Đường dẫn hình nền</string>
            <key>placeholder</key>
            <string>/var/jb/Library/DINBackground.png</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>default</key>
            <real>1.0</real>
            <key>defaults</key>
            <string>com.34306.shimastyle</string>
            <key>key</key>
            <string>backgroundOpacity</string>
            <key>label</key>
            <string>Độ mờ nền</string>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>1.0</real>
            <key>showValue</key>
            <true/>
        </dict>

        <!-- Respring Button -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>Cần respring để các thay đổi về hình nền có hiệu lực.</string>
        </dict>

        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Khởi động lại (Respring)</string>
            <key>action</key>
            <string>respring</string>
        </dict>

        <!-- Credits -->
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>footerText</key>
            <string>ShimaStyle v1.0.0
Hỗ trợ iOS 16 - 26.</string>
        </dict>
    </array>
    <key>title</key>
    <string>ShimaStyle</string>
</dict>
</plist>
